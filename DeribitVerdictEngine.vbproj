<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DeribitVerdictEngine</RootNamespace>
    <AssemblyName>DeribitVerdictEngine</AssemblyName>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- WebSocket transport (migration P1, v38) uses the framework's
       System.Net.WebSockets.ClientWebSocket directly — no NuGet package.
       The unused Websocket.Client 5.1.2 reference (added 2026-04-01, never
       referenced) was removed here; if P2 adopts a managed-reconnect library,
       re-add the LATEST version then. -->

  <!-- Exclude the AutoTweaker console project from SDK auto-discovery.
       AutoTweaker has its own .vbproj and must not be compiled into this assembly.
       TweakerConfig and TweakerState are re-included because TweakSettingsForm uses
       them directly; they are host-agnostic POCOs with no WinForms references. -->
  <ItemGroup>
    <Compile Remove="tools\**\*.vb" />
    <None Remove="tools\**\*.vb" />
  </ItemGroup>

  <!-- Exclude the verify/ acceptance harness (verify/ordercheck/, gitignored,
       own .vbproj that links these sources) from SDK auto-discovery so a nested
       harness project can never break the solution build. -->
  <ItemGroup>
    <Compile Remove="verify\**\*.vb" />
    <None Remove="verify\**\*.vb" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="tools\AutoTweaker\TweakerConfig.vb" />
    <Compile Include="tools\AutoTweaker\TweakerState.vb" />
    <Compile Include="tools\AutoTweaker\CompositeScorer.vb" />
    <Compile Include="tools\AutoTweaker\ConditionsExtractor.vb" />
    <Compile Include="tools\AutoTweaker\SnapshotManager.vb" />
    <Compile Include="tools\AutoTweaker\RoundStatsBuilder.vb" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy settings.json to output directory so the app finds it at runtime -->
    <None Include="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- UI reskin P1: bundle Geist Mono as embedded resources. OFL.txt ships
       as Content next to the .exe so the SIL OFL 1.1 licence travels with
       the font, satisfying the redistribution requirement. -->
  <ItemGroup>
    <EmbeddedResource Include="fonts\GeistMono-Regular.ttf" />
    <EmbeddedResource Include="fonts\GeistMono-Bold.ttf" />
    <EmbeddedResource Include="fonts\GeistMono-SemiBold.ttf" />
    <Content Include="fonts\OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
