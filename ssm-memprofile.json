{
  "commands": [
    "$p=Get-Process DeribitVerdictEngine -ErrorAction SilentlyContinue",
    "if(-not $p){'app NOT RUNNING'; exit 0}",
    "'host          {0}' -f $env:COMPUTERNAME",
    "'app uptime    {0,7:N1} h' -f ((Get-Date)-$p.StartTime).TotalHours",
    "'private       {0,7:N1} MB' -f ($p.PrivateMemorySize64/1MB)",
    "'working set   {0,7:N1} MB' -f ($p.WorkingSet64/1MB)",
    "'virtual       {0,7:N1} MB' -f ($p.VirtualMemorySize64/1MB)",
    "'handles       {0,7:N0}   <-- leak indicator' -f $p.HandleCount",
    "'threads       {0,7:N0}   <-- leak indicator' -f $p.Threads.Count",
    "''",
    "$bs=[string][char]92",
    "$inst='DeribitVerdictEngine'",
    "$names=@('# Bytes in all Heaps','Gen 0 heap size','Gen 1 heap size','Gen 2 heap size','Large Object Heap size','# Total committed Bytes')",
    "foreach($c in $names){",
    "  $path=$bs + '.NET CLR Memory(' + $inst + ')' + $bs + $c",
    "  try {",
    "    $v=(Get-Counter $path -ErrorAction Stop).CounterSamples[0].CookedValue",
    "    'CLR {0,-24} {1,9:N1} MB' -f $c,($v/1MB)",
    "  } catch { 'CLR {0,-24} unavailable' -f $c }",
    "}",
    "try {",
    "  $g2=(Get-Counter ($bs + '.NET CLR Memory(' + $inst + ')' + $bs + '# Gen 2 Collections') -ErrorAction Stop).CounterSamples[0].CookedValue",
    "  'CLR gen2 collections    {0,9:N0}' -f $g2",
    "} catch { 'CLR gen2 collections    unavailable' }",
    "''",
    "$d=Split-Path $p.Path",
    "foreach($f in @('analysis_log.csv','analysis_eval_cache.csv','ohlc_1m_cache.csv')){",
    "  $fp=Join-Path $d $f",
    "  if(Test-Path $fp){",
    "    $rows=0; foreach($l in [System.IO.File]::ReadLines($fp)){$rows++}",
    "    'file {0,-24} {1,7:N1} MB  {2,8:N0} rows' -f $f,((Get-Item $fp).Length/1MB),$rows",
    "  } else { 'file {0,-24} absent' -f $f }",
    "}"
  ]
}
