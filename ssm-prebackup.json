{
  "commands": [
    "$ErrorActionPreference='Continue'",
    "$p=Get-Process DeribitVerdictEngine -ErrorAction SilentlyContinue",
    "if(-not $p){'app NOT RUNNING - aborting, this backup is meant to be taken while healthy'; exit 1}",
    "$dir=Split-Path $p.Path",
    "$bk=Join-Path $dir '_manual_backup'",
    "'source  {0}' -f $dir",
    "'backup  {0}' -f $bk",
    "'app is RUNNING (pid {0}) - files are copied, nothing is stopped' -f $p.Id",
    "Remove-Item -Recurse -Force $bk -ErrorAction SilentlyContinue",
    "New-Item -ItemType Directory -Force $bk | Out-Null",
    "$six=@('DeribitVerdictEngine.exe','DeribitVerdictEngine.dll','DeribitVerdictEngine.deps.json','DeribitVerdictEngine.runtimeconfig.json','settings.json')",
    "$dirs=@('fonts')",
    "$err=$null",
    "try {",
    "  foreach($f in $six){ Copy-Item (Join-Path $dir $f) (Join-Path $bk $f) -Force -ErrorAction Stop }",
    "  foreach($d in $dirs){ Copy-Item (Join-Path $dir $d) (Join-Path $bk $d) -Recurse -Force -ErrorAction Stop }",
    "} catch { $err = $_.Exception.Message }",
    "if($err){ 'BACKUP=error:' + $err; exit 1 }",
    "$missing=@()",
    "foreach($f in $six){ if(-not (Test-Path (Join-Path $bk $f))){ $missing += $f } }",
    "foreach($d in $dirs){",
    "  $bp=Join-Path $bk $d",
    "  if(-not (Test-Path $bp)){ $missing += $d; continue }",
    "  $s=(Get-ChildItem (Join-Path $dir $d) -Recurse -File | Measure-Object).Count",
    "  $b=(Get-ChildItem $bp -Recurse -File | Measure-Object).Count",
    "  if($s -ne $b){ $missing += ($d + ' count ' + $b + ' vs ' + $s) }",
    "}",
    "''",
    "'--- what was backed up ---'",
    "Get-ChildItem $bk -Recurse -File | ForEach-Object { '  {0,-40} {1,10:N0} bytes' -f $_.FullName.Substring($bk.Length+1),$_.Length }",
    "''",
    "'--- TRAP 1 check: these must all be False ---'",
    "'  backtest_data in backup?      {0}' -f (Test-Path (Join-Path $bk 'backtest_data'))",
    "'  analysis_log.csv in backup?   {0}' -f (Test-Path (Join-Path $bk 'analysis_log.csv'))",
    "'  eval cache in backup?         {0}' -f (Test-Path (Join-Path $bk 'analysis_eval_cache.csv'))",
    "'  settings.local.json present?  {0}' -f (Test-Path (Join-Path $dir 'settings.local.json'))",
    "''",
    "if($missing.Count -gt 0){ 'BACKUP=incomplete:' + ($missing -join ',') } else { 'BACKUP=done - all six items verified present' }",
    "'deployed settings version: ' + ((Get-Content (Join-Path $dir 'settings.json') -TotalCount 2) -join ' ')"
  ]
}
