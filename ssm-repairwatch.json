{
  "commands": [
    "$p=Get-Process DeribitVerdictEngine -ErrorAction SilentlyContinue",
    "if(-not $p){'app NOT RUNNING'; exit 1}",
    "$dir=Split-Path $p.Path",
    "$store=Join-Path $dir 'backtest_data'",
    "'host       {0}' -f $env:COMPUTERNAME",
    "'app up     {0,7:N2} h' -f ((Get-Date)-$p.StartTime).TotalHours",
    "'start UTC  {0:yyyy-MM-dd HH:mm:ss}' -f $p.StartTime.ToUniversalTime()",
    "'now   UTC  {0:yyyy-MM-dd HH:mm:ss}' -f (Get-Date).ToUniversalTime()",
    "$sz0=(Get-ChildItem $store -File | Measure-Object -Property Length -Sum).Sum",
    "'store at t0 {0,10:N0} bytes' -f $sz0",
    "''",
    "'=== 5-minute sweep, one line per 10s. A repair shows as: store GROWS, pagesIN spikes, avail dips ==='",
    "'time      avail   pageIN   pageOUT  pagefile   appPVT   storeDelta'",
    "for($i=0;$i -lt 30;$i++){",
    "  $c=Get-Counter '\\Memory\\Available MBytes','\\Memory\\Pages Input/sec','\\Memory\\Pages Output/sec','\\Paging File(_Total)\\% Usage' -SampleInterval 1 -MaxSamples 1",
    "  $s=$c.CounterSamples",
    "  $av=($s | Where-Object {$_.Path -like '*available mbytes'}).CookedValue",
    "  $pi=($s | Where-Object {$_.Path -like '*pages input/sec'}).CookedValue",
    "  $po=($s | Where-Object {$_.Path -like '*pages output/sec'}).CookedValue",
    "  $pf=($s | Where-Object {$_.Path -like '*% usage'}).CookedValue",
    "  $pr=Get-Process DeribitVerdictEngine -ErrorAction SilentlyContinue",
    "  $pv=if($pr){$pr.PrivateMemorySize64/1MB}else{0}",
    "  $sz=(Get-ChildItem $store -File | Measure-Object -Property Length -Sum).Sum",
    "  '{0:HH:mm:ss} {1,7:N0} {2,8:N1} {3,9:N1} {4,8:N1}% {5,8:N1} {6,12:N0}' -f (Get-Date),$av,$pi,$po,$pf,$pv,($sz-$sz0)",
    "  Start-Sleep -Seconds 9",
    "}",
    "''",
    "$sz1=(Get-ChildItem $store -File | Measure-Object -Property Length -Sum).Sum",
    "'store grew {0:N0} bytes over the sweep' -f ($sz1-$sz0)",
    "if(($sz1-$sz0) -gt 0){'==> the store GREW during this window - a repair or streaming write landed here'}else{'==> no store growth - if a repair ran, it found nothing to fill'}"
  ]
}
