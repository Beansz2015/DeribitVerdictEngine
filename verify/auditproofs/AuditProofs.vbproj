    <Compile Include="../../analysis/AnalysisReport.vb" />
    <Compile Include="../../analysis/BandLadder.vb" />
    <Compile Include="../../analysis/MarkdownReportWriter.vb" />
    <Compile Include="../../analysis/ForwardWindowJoiner.vb" />
    <Compile Include="../../analysis/DeribitOhlcFetcher.vb" />
    <Compile Include="../../tools/WhatIfRunner/WhatIfOverlay.vb" />
    <Compile Include="../../tools/WhatIfRunner/WhatIfReplay.vb" />
    <Compile Include="../../tools/WhatIfRunner/WhatIfReport.vb" />
    <Compile Include="../../tools/WhatIfRunner/WhatIfSettings.vb" />
    <Compile Include="../../tools/AutoTweaker/TweakerConfig.vb" />
    <Compile Include="../../tools/AutoTweaker/TweakerState.vb" />
    <Compile Include="../../tools/AutoTweaker/SettingsDiffApplier.vb" />
    <Compile Include="../../tools/AutoTweaker/PromptBuilder.vb" />
    <Compile Include="../../tools/AutoTweaker/ClaudeApiClient.vb" />
    <Compile Include="../../tools/AutoTweaker/ConditionsExtractor.vb" />
    <Compile Include="../../tools/AutoTweaker/CompositeScorer.vb" />
