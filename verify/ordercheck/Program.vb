        cfg.SessionVolume.Sessions(0).RocMagnitudeThreshold = 0.17   ' ASIA  hr 0-7 (v41 Monday recal)
        cfg.SessionVolume.Sessions(1).RocMagnitudeThreshold = 0.11   ' LONDON hr 8-12
