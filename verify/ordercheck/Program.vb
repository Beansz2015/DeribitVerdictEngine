        Dim s As New List(Of Tuple(Of String, Action(Of IndicatorResults)))()
        Dim add = Sub(name As String, act As Action(Of IndicatorResults)) s.Add(Tuple.Create(name, act))
        add("ROC full", Sub(r)
                            r.ROC = 2 * r.RocMagnitudeThreshold + 0.01
                            r.ROCSlope = "RISING"
