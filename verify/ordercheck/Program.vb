              lvL.Target = 62100.0 AndAlso lvL.Capped AndAlso
              lvL.Reason = "PLACED @ 62100.0 (SWING_HIGH_5M)" AndAlso
              lvL.TargetReason = "SWING_HIGH_5M" AndAlso
