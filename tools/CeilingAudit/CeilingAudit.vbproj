<Project Sdk="Microsoft.NET.Sdk">

  <!-- W6-4 offline ceiling-audit instrument (docs/w6-4-ceiling-audit-method-proposal.md).
       Analysis-only console app. Reads a pooled analysis_log.csv, fits a hand-rolled L2
       logistic on scored pipeline inputs, compares its AUC/Brier against the pipeline's own
       effective-score baseline under walk-forward + block-bootstrap discipline, writes
       ceiling_audit_report_<stamp>.md. Zero engine impact, never writes settings.json.
       net8.0 + zero WinForms references — runs on Linux via `dotnet CeilingAudit.dll`. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>DeribitVerdictEngine</RootNamespace>
    <AssemblyName>CeilingAudit</AssemblyName>
    <Nullable>enable</Nullable>
    <StartupObject>DeribitVerdictEngine.CeilingAuditProgram</StartupObject>
  </PropertyGroup>

  <!-- Host-agnostic shared files from the main project — no WinForms references in any of
       these. The tool reuses the SHIPPED FailureRateMatrix outcome walk + ForwardWindowJoiner
       CSV+OHLC conventions, so the label is placed-vs-placed by construction, identical to
       the offline matrix / D4 / What-If eval stacks. -->
  <ItemGroup>
    <Compile Include="..\..\Core\Settings\EngineSettings.vb" />
    <Compile Include="..\..\Core\Settings\SettingsLoader.vb" />
    <Compile Include="..\..\Core\ExecutionResolution.vb" />
    <Compile Include="..\..\DeribitClient.vb" />
    <Compile Include="..\..\analysis\AnalysisConstants.vb" />
    <Compile Include="..\..\analysis\AnalysisReport.vb" />
    <Compile Include="..\..\analysis\ForwardWindowJoiner.vb" />
    <Compile Include="..\..\analysis\DeribitOhlcFetcher.vb" />
    <Compile Include="..\..\analysis\FailureRateMatrix.vb" />
    <!-- BandLadderRow POCO referenced by AnalysisReport (transitive dep). -->
    <Compile Include="..\..\analysis\BandLadder.vb" />
  </ItemGroup>

  <!-- CsvFeatureBuilder.vb, L2Logistic.vb, AuditMetrics.vb, AuditReport.vb,
       CeilingAuditProgram.vb are auto-included by the SDK glob (they live here). -->

</Project>
