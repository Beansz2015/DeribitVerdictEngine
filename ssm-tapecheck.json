{
  "commands": [
    "$ErrorActionPreference='Stop'",
    "$f='C:\\DeribitVerdictEngine\\backtest_data\\trades_2026-08.csv'",
    "if(-not (Test-Path $f)){'STORE FILE ABSENT: '+$f; exit 0}",
    "$from=[DateTimeOffset]::new(2026,8,18,8,54,0,[TimeSpan]::Zero).ToUnixTimeMilliseconds()",
    "$to  =[DateTimeOffset]::new(2026,8,18,10,37,0,[TimeSpan]::Zero).ToUnixTimeMilliseconds()",
    "'window   2026-08-18 08:54:00Z -> 10:37:00Z  (DEGRADED was 09:04:04 -> 10:26:55)'",
    "'file     {0:N1} MB' -f ((Get-Item $f).Length/1MB)",
    "$seqs=New-Object 'System.Collections.Generic.HashSet[long]'",
    "$perMin=@{}; $rows=0; $noSeq=0; $total=0",
    "foreach($line in [System.IO.File]::ReadLines($f)){",
    "  $total++",
    "  $c=$line.IndexOf(','); if($c -lt 1){continue}",
    "  $tsRaw=$line.Substring(0,$c)",
    "  [long]$ts=0; if(-not [long]::TryParse($tsRaw,[ref]$ts)){continue}",
    "  if($ts -lt $from -or $ts -gt $to){continue}",
    "  $rows++",
    "  $p=$line.Split(',')",
    "  $k=[DateTimeOffset]::FromUnixTimeMilliseconds($ts).UtcDateTime.ToString('HH:mm')",
    "  $perMin[$k]=1+$perMin[$k]",
    "  if($p.Length -ge 7 -and $p[6] -ne ''){ [long]$s=0; if([long]::TryParse($p[6],[ref]$s) -and $s -ge 0){[void]$seqs.Add($s)} else {$noSeq++} } else {$noSeq++}",
    "}",
    "'file rows total      {0:N0}' -f $total",
    "'rows in window       {0:N0}' -f $rows",
    "'rows with NO seq     {0:N0}' -f $noSeq",
    "if($seqs.Count -eq 0){'NO trade_seq VALUES IN WINDOW - cannot assess'; exit 0}",
    "$mn=($seqs|Measure-Object -Minimum).Minimum; $mx=($seqs|Measure-Object -Maximum).Maximum",
    "$span=$mx-$mn+1; $miss=$span-$seqs.Count",
    "''",
    "'--- trade_seq continuity across the window ---'",
    "'min seq              {0:N0}' -f $mn",
    "'max seq              {0:N0}' -f $mx",
    "'span (max-min+1)     {0:N0}' -f $span",
    "'distinct present     {0:N0}' -f $seqs.Count",
    "'MISSING              {0:N0}   ({1:N3} %)' -f $miss,(100*$miss/$span)",
    "if($miss -eq 0){'==> NO MISSING SEQUENCES. The tape is COMPLETE for this window. 26a0 This does NOT prove gap repair healed anything - contiguous seqs across a TIME void means the VENUE assigned no seqs, i.e. no trades occurred. Check the per-minute burst on resume to confirm a halt. Gap repair healing remains UNTESTED until a window shows missing seqs that a later pass fills.'}else{'==> {0:N0} SEQUENCE NUMBERS MISSING - investigate' -f $miss}",
    "''",
    "'--- rows per minute (a hole shows as missing/!!low minutes) ---'",
    "$perMin.GetEnumerator() | Sort-Object Name | ForEach-Object { '{0}  {1,5}  {2}' -f $_.Name,$_.Value,('#'*[Math]::Min(40,[int]($_.Value/4))) }"
  ]
}
