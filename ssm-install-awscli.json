{
  "commands": [
    "$ErrorActionPreference='Stop'",
    "$ProgressPreference='SilentlyContinue'",
    "$existing=Get-Command aws -ErrorAction SilentlyContinue",
    "if($existing){ 'ALREADY INSTALLED: ' + (aws --version 2>&1); exit 0 }",
    "$os=Get-CimInstance Win32_OperatingSystem",
    "$p0=Get-Process DeribitVerdictEngine -ErrorAction SilentlyContinue",
    "'--- before ---'",
    "'  avail  {0,6:N0} MB' -f ($os.FreePhysicalMemory/1KB)",
    "if($p0){'  app    PID {0}, private {1:N0} MB' -f $p0.Id,($p0.PrivateMemorySize64/1MB)}else{'  app NOT RUNNING'}",
    "'  disk   {0:N1} GB free' -f ((Get-PSDrive C).Free/1GB)",
    "''",
    "$msi=Join-Path $env:TEMP 'AWSCLIV2.msi'",
    "'downloading AWS CLI v2 from the official AWS distribution over HTTPS...'",
    "[Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12",
    "Invoke-WebRequest -Uri 'https://awscli.amazonaws.com/AWSCLIV2.msi' -OutFile $msi -UseBasicParsing",
    "'  downloaded {0:N1} MB' -f ((Get-Item $msi).Length/1MB)",
    "$sig=Get-AuthenticodeSignature $msi",
    "'  signature  {0}  signer: {1}' -f $sig.Status,$(if($sig.SignerCertificate){$sig.SignerCertificate.Subject}else{'(none)'})",
    "if($sig.Status -ne 'Valid'){ 'ABORTING - MSI signature is not Valid'; Remove-Item $msi -Force -ErrorAction SilentlyContinue; exit 1 }",
    "''",
    "'installing silently (msiexec /qn)...'",
    "$proc=Start-Process msiexec.exe -ArgumentList \"/i `\"$msi`\" /qn /norestart\" -Wait -PassThru",
    "'  msiexec exit code: {0}' -f $proc.ExitCode",
    "if($proc.ExitCode -ne 0 -and $proc.ExitCode -ne 3010){ 'INSTALL FAILED'; exit 1 }",
    "Remove-Item $msi -Force -ErrorAction SilentlyContinue",
    "''",
    "$env:Path=[System.Environment]::GetEnvironmentVariable('Path','Machine')+';'+[System.Environment]::GetEnvironmentVariable('Path','User')",
    "'--- verify ---'",
    "$v=(& 'C:\\Program Files\\Amazon\\AWSCLIV2\\aws.exe' --version 2>&1)",
    "'  ' + $v",
    "''",
    "'--- after ---'",
    "$os2=Get-CimInstance Win32_OperatingSystem",
    "$p1=Get-Process DeribitVerdictEngine -ErrorAction SilentlyContinue",
    "'  avail  {0,6:N0} MB' -f ($os2.FreePhysicalMemory/1KB)",
    "if($p1){'  app    PID {0} STILL RUNNING, private {1:N0} MB' -f $p1.Id,($p1.PrivateMemorySize64/1MB)}else{'  ** APP NOT RUNNING - INVESTIGATE **'}",
    "'  disk   {0:N1} GB free' -f ((Get-PSDrive C).Free/1GB)",
    "if($p0 -and $p1 -and $p0.Id -eq $p1.Id){'  app PID unchanged - the install did not disturb it'}",
    "''",
    "'--- can it reach the collector bucket? (proves the instance-role path end to end) ---'",
    "& 'C:\\Program Files\\Amazon\\AWSCLIV2\\aws.exe' s3 ls s3://deribit-engine-bucket/ --region eu-west-2 2>&1 | Select-Object -First 5"
  ]
}
