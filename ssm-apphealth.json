{
  "commands": [
    "$p=Get-Process DeribitVerdictEngine -ErrorAction SilentlyContinue",
    "if(-not $p){'app NOT RUNNING'; exit 0}",
    "$dir=Split-Path $p.Path",
    "'dir       {0}' -f $dir",
    "'exe built {0:yyyy-MM-dd HH:mm}' -f (Get-Item $p.Path).LastWriteTime",
    "$sj=Join-Path $dir 'settings.json'",
    "if(Test-Path $sj){'settings  {0}' -f ((Get-Content $sj -TotalCount 2) -join ' ').Trim()}",
    "'overlay   {0}' -f (Test-Path (Join-Path $dir 'settings.local.json'))",
    "'.NET desktop runtimes:'",
    "(dotnet --list-runtimes 2>$null | Select-String 'WindowsDesktop') -join \"`n\"",
    "''",
    "$csv=Join-Path $dir 'analysis_log.csv'",
    "if(Test-Path $csv){",
    "  $l=Get-Content $csv",
    "  'csv rows  {0}' -f ($l.Count-1)",
    "  if($l.Count -gt 1){",
    "    'first row {0}' -f ($l[1].Split(',')[0])",
    "    'last row  {0}' -f ($l[-1].Split(',')[0])",
    "    $t0=[datetime]::Parse($l[1].Split(',')[0]); $t1=[datetime]::Parse($l[-1].Split(',')[0])",
    "    $mins=($t1-$t0).TotalMinutes",
    "    if($mins -gt 0){'rows/hour {0:N1}' -f ((($l.Count-2)/$mins)*60)}",
    "    'gap now-lastrow (min) {0:N1}' -f ((Get-Date).ToUniversalTime()-$t1).TotalMinutes",
    "    $v=@{}; $l[1..($l.Count-1)] | %{ $f=$_.Split(',')[2]; if($f){$v[$f]=1+$v[$f]} }",
    "    'verdicts  ' + (($v.GetEnumerator()|Sort-Object Value -Descending|%{ $_.Key+'='+$_.Value }) -join ' ')",
    "  }",
    "} else {'analysis_log.csv ABSENT'}",
    "''",
    "$wsh=Join-Path $dir 'ws_health.log'",
    "if(Test-Path $wsh){'ws_health tail:'; (Get-Content $wsh -Tail 4) -join \"`n\"} else {'ws_health.log absent'}",
    "$store=Join-Path $dir 'backtest_data'",
    "if(Test-Path $store){'store files: ' + ((Get-ChildItem $store -Filter *.csv | %{ $_.Name+'('+[int]($_.Length/1KB)+'KB)' }) -join ' ')} else {'store dir absent'}"
  ]
}
